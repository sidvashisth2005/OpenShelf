# ---------------------------------------------------------------------------
# Database
# Leave DATABASE_URL empty in local dev to use embedded Postgres (PGlite) under
# PGLITE_DIR. In production ALWAYS set a real Postgres URL.
# ---------------------------------------------------------------------------
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ---------------------------------------------------------------------------
# Storage (local disk driver). Swap the driver in src/server/storage for S3/R2.
# ---------------------------------------------------------------------------
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
SESSION_TTL_DAYS=7
ADMIN_SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Super Admin (single, config-driven account — never created via signup)
# Generate the hash with:  npm run admin:hash
# The value is a BASE64-encoded bcrypt hash (bcrypt hashes contain "$", which
# .env files would otherwise try to expand). Never put a plaintext password here.
# Leave both empty to disable super admin login entirely.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH_B64=

# ---------------------------------------------------------------------------
# Public info shown in Terms / Privacy pages
# ---------------------------------------------------------------------------
PLATFORM_NAME=OpenShelf
PLATFORM_CONTACT_EMAIL=

# Used by docker-compose.yml for the bundled Postgres container
POSTGRES_PASSWORD=
